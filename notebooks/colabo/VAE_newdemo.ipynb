        "    transforms.ColorJitter(brightness=0.2, contrast=0.2),  # New: Simulates lighting variations\n",
        "    transforms.ToTensor()\n",
        "])\n",
        "\n",
        "dataset = datasets.ImageFolder(\n",
        "    root='./dataset_root',\n",
        "    transform=transform  # Updated to use the new transform\n",
        ")\n",
        "\n",
        "dataloader = torch.utils.data.DataLoader(\n",
        "    dataset,\n",
        "    batch_size=bs,\n",
        "    shuffle=True,\n",
        "    num_workers=2,\n",
        "    pin_memory=True\n",
        ")\n",
