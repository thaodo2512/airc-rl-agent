# Import necessary libraries
from google.colab import drive
import os
import zipfile
import torch
import torch.nn as nn
import torch.nn.functional as F
import torch.optim as optim
from torch.utils.data import DataLoader
from torchvision import datasets, transforms
from tensorboardX import SummaryWriter
import matplotlib.pyplot as plt

# Mount Google Drive
drive.mount('/content/drive')

# Define dataset ZIP file path (adjust as needed)
DATASET_ZIP = '/content/drive/MyDrive/jetbot_dataset.zip'  # Change to your actual ZIP file name/path

# Unzip the dataset
with zipfile.ZipFile(DATASET_ZIP, 'r') as zip_ref:
    zip_ref.extractall('/content/dataset_root')

# Check the extracted files
!ls /content/dataset_root

# Define transformations: Resize, crop top 40 pixels, convert to tensor
transform = transforms.Compose([
    transforms.Resize((120, 160)),  # Resize to 120 height, 160 width
    transforms.Lambda(lambda x: x.crop((0, 40, 160, 120))),  # Crop top 40 pixels to get 80x160
    transforms.ToTensor()
])

# Load the dataset
dataset = datasets.ImageFolder(root='/content/dataset_root', transform=transform)
dataloader = DataLoader(dataset, batch_size=64, shuffle=True, num_workers=2, pin_memory=True)

# Check dataset size
print(f"Dataset size: {len(dataset)}")

# Set device
device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')
print(f"Using device: {device}")

# Define hyperparameters
latent_dim = 32  # Latent dimension (adjust to match your SAC config)
beta = 1.0  # Beta for KL divergence weighting
epochs = 50  # Number of training epochs
lr = 1e-3  # Learning rate
log_dir = './vae_logs'  # TensorBoard log directory
model_save_path = '/content/drive/MyDrive/vae_model.pth'  # Save path on Drive

# Initialize TensorBoard writer
writer = SummaryWriter(log_dir)

# Define the Encoder
class Encoder(nn.Module):
    def __init__(self, latent_dim):
        super(Encoder, self).__init__()
        self.conv = nn.Sequential(
            nn.Conv2d(3, 32, kernel_size=4, stride=2, padding=1),  # 3x80x160 -> 32x40x80
            nn.ReLU(),
            nn.Conv2d(32, 64, kernel_size=4, stride=2, padding=1),  # -> 64x20x40
            nn.ReLU(),
            nn.Conv2d(64, 128, kernel_size=4, stride=2, padding=1),  # -> 128x10x20
            nn.ReLU(),
            nn.Conv2d(128, 256, kernel_size=4, stride=2, padding=1),  # -> 256x5x10
            nn.ReLU(),
            nn.Flatten()
        )
        self.fc_mu = nn.Linear(256 * 5 * 10, latent_dim)
        self.fc_logvar = nn.Linear(256 * 5 * 10, latent_dim)

    def forward(self, x):
        h = self.conv(x)
        mu = self.fc_mu(h)
        logvar = self.fc_logvar(h)
        return mu, logvar

# Define the Decoder
class Decoder(nn.Module):
    def __init__(self, latent_dim):
        super(Decoder, self).__init__()
        self.fc = nn.Linear(latent_dim, 256 * 5 * 10)
        self.deconv = nn.Sequential(
            nn.ReLU(),
            nn.ConvTranspose2d(256, 128, kernel_size=4, stride=2, padding=1),  # 256x5x10 -> 128x10x20
            nn.ReLU(),
            nn.ConvTranspose2d(128, 64, kernel_size=4, stride=2, padding=1),  # -> 64x20x40
            nn.ReLU(),
            nn.ConvTranspose2d(64, 32, kernel_size=4, stride=2, padding=1),  # -> 32x40x80
            nn.ReLU(),
            nn.ConvTranspose2d(32, 3, kernel_size=4, stride=2, padding=1),  # -> 3x80x160
            nn.Sigmoid()  # Output in [0,1] for images
        )

    def forward(self, z):
        h = self.fc(z)
        h = h.view(-1, 256, 5, 10)
        return self.deconv(h)

# Define the VAE
class VAE(nn.Module):
    def __init__(self, latent_dim):
        super(VAE, self).__init__()
        self.encoder = Encoder(latent_dim)
        self.decoder = Decoder(latent_dim)

    def reparameterize(self, mu, logvar):
        std = torch.exp(0.5 * logvar)
        eps = torch.randn_like(std)
        return mu + eps * std

    def forward(self, x):
        mu, logvar = self.encoder(x)
        z = self.reparameterize(mu, logvar)
        return self.decoder(z), mu, logvar

# Initialize the VAE model
vae = VAE(latent_dim).to(device)

# Define the loss function (beta-VAE)
def vae_loss(recon_x, x, mu, logvar, beta=1.0):
    BCE = F.binary_cross_entropy(recon_x, x, reduction='sum')
    KLD = -0.5 * torch.sum(1 + logvar - mu.pow(2) - logvar.exp())
    return (BCE + beta * KLD) / x.size(0)  # Normalize by batch size

# Set up optimizer
optimizer = optim.Adam(vae.parameters(), lr=lr)

# Training loop
for epoch in range(1, epochs + 1):
    vae.train()
    train_loss = 0
    for batch_idx, (data, _) in enumerate(dataloader):
        data = data.to(device)
        optimizer.zero_grad()
        recon_batch, mu, logvar = vae(data)
        loss = vae_loss(recon_batch, data, mu, logvar, beta)
        loss.backward()
        train_loss += loss.item()
        optimizer.step()

    avg_loss = train_loss / len(dataloader.dataset)
    print(f'Epoch {epoch}: Average Loss {avg_loss:.4f}')
    writer.add_scalar('Loss/train', avg_loss, epoch)

# Save the model to Google Drive
torch.save(vae.state_dict(), model_save_path)
print(f"Model saved to {model_save_path}")

# Close TensorBoard writer
writer.close()

# Optional: Visualize reconstructions
vae.eval()
with torch.no_grad():
    sample_batch, _ = next(iter(dataloader))
    sample_batch = sample_batch[:8].to(device)
    recon, _, _ = vae(sample_batch)
    fig, axs = plt.subplots(2, 8, figsize=(16, 4))
    for i in range(8):
        axs[0, i].imshow(sample_batch[i].cpu().permute(1, 2, 0))
        axs[0, i].axis('off')
        axs[0, i].set_title('Original')
        axs[1, i].imshow(recon[i].cpu().permute(1, 2, 0))
        axs[1, i].axis('off')
        axs[1, i].set_title('Recon')
    plt.show()

